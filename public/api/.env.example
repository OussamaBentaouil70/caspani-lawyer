# Mail settings for api/send.php — copy this file to ".env" in the same folder and fill in the values.
# The real .env is never committed to git (see .gitignore) and is blocked from web access by api/.htaccess.

# --- SMTP account that sends the emails ---------------------------------------------------------
# Gmail (testing): smtp.gmail.com, port 587, tls, your Gmail address and a 16-character App Password
#   (Google Account > Security > 2-Step Verification > App passwords). Your normal Gmail password will not work.
# Hostinger (production): smtp.hostinger.com, port 465, ssl, an email account created in hPanel.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-character-app-password

# --- Sender shown on both emails (with Gmail this must be the same address as SMTP_USER) ----------
MAIL_FROM=your.address@gmail.com
MAIL_FROM_NAME=Caspani Lawyers

# --- Where new consultation requests are delivered ----------------------------------------------
ADMIN_EMAIL=your.address@gmail.com

# --- Public address of the website (used for links inside the emails) ---------------------------
SITE_URL=https://www.caspanilawyers.com

# --- Set to true only while testing: error details are then returned to the browser --------------
APP_DEBUG=false
